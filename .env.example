# Create a new bot with @BotFather, then paste its private token below.
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# restricted mode allows only these numeric Telegram IDs. Public cloud mode
# ignores the allowlist and creates a private inventory for each Telegram user.
TELEGRAM_ALLOWED_USER_IDS=

# Public mode requires STORAGE_BACKEND=postgres and DATABASE_URL.
BOT_ACCESS_MODE=restricted
STORAGE_BACKEND=json
DATABASE_URL=
# Path to Supabase's downloaded root CA certificate; required for public mode.
DATABASE_SSL_ROOT_CERT=
# For Vercel, base64-encoded Supabase root CA certificate in a private env var.
DATABASE_SSL_ROOT_CERT_B64=
# Telegram webhook secret token (1-256 URL-safe characters); never commit a real value.
TELEGRAM_WEBHOOK_SECRET=

# Optional private-chat maintenance access for /status only.
TELEGRAM_ADMIN_USER_IDS=

# Optional. Leave blank to use data/inventory.json
INVENTORY_DATA_PATH=

# Products at or below this quantity appear in low-stock alerts (default 5).
LOW_STOCK_LIMIT=5
