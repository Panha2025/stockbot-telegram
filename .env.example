# Token from @BotFather; keep the real value only in your local .env file.
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Optional numeric Telegram IDs allowed to use the admin-only /status command.
TELEGRAM_ADMIN_USER_IDS=

# Optional. Leave blank to use the default low-stock threshold of 5.
LOW_STOCK_LIMIT=5
